DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        roles LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Subscription (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        channelID STRING,
        sourceRawValue STRING,
        instanceURLString STRING,
        name STRING,
        channelDescription STRING,
        subscriberCount INT64,
        avatarURLString STRING,
        bannerURLString STRING,
        isVerified INT64,
        subscribedAt TIMESTAMP,
        lastUpdatedAt TIMESTAMP,
        providerName STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE WatchEntry (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        videoID STRING,
        sourceRawValue STRING,
        globalProvider STRING,
        instanceURLString STRING,
        peertubeUUID STRING,
        externalExtractor STRING,
        externalURLString STRING,
        title STRING,
        authorName STRING,
        authorID STRING,
        duration DOUBLE,
        thumbnailURLString STRING,
        isLive INT64,
        watchedSeconds DOUBLE,
        isFinished INT64,
        finishedAt TIMESTAMP,
        createdAt TIMESTAMP,
        updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Bookmark (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        videoID STRING,
        sourceRawValue STRING,
        globalProvider STRING,
        instanceURLString STRING,
        peertubeUUID STRING,
        externalExtractor STRING,
        externalURLString STRING,
        title STRING,
        authorName STRING,
        authorID STRING,
        duration DOUBLE,
        thumbnailURLString STRING,
        isLive INT64,
        viewCount INT64,
        publishedAt TIMESTAMP,
        publishedText STRING,
        createdAt TIMESTAMP,
        note STRING,
        noteModifiedAt TIMESTAMP,
        tags LIST<STRING>,
        tagsModifiedAt TIMESTAMP,
        sortOrder INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LocalPlaylist (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        playlistID STRING,
        title STRING,
        playlistDescription STRING,
        createdAt TIMESTAMP,
        updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LocalPlaylistItem (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        itemID STRING,
        playlistID STRING,
        sortOrder INT64,
        videoID STRING,
        sourceRawValue STRING,
        globalProvider STRING,
        instanceURLString STRING,
        peertubeUUID STRING,
        externalExtractor STRING,
        externalURLString STRING,
        title STRING,
        authorName STRING,
        authorID STRING,
        duration DOUBLE,
        thumbnailURLString STRING,
        isLive INT64,
        addedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SearchHistory (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        searchID STRING,
        query STRING,
        searchedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RecentChannel (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        recentID STRING,
        channelID STRING,
        sourceRawValue STRING,
        instanceURLString STRING,
        name STRING,
        thumbnailURLString STRING,
        subscriberCount INT64,
        isVerified INT64,
        visitedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE RecentPlaylist (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        recentID STRING,
        playlistID STRING,
        sourceRawValue STRING,
        instanceURLString STRING,
        title STRING,
        authorName STRING,
        videoCount INT64,
        thumbnailURLString STRING,
        visitedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ChannelNotificationSettings (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        channelID STRING,
        notificationsEnabled INT64,
        updatedAt TIMESTAMP,
        sourceRawValue STRING,
        instanceURLString STRING,
        globalProvider STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ControlsPreset (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        presetID STRING,
        name STRING,
        createdAt TIMESTAMP,
        updatedAt TIMESTAMP,
        isBuiltIn INT64,
        deviceClass STRING,
        layoutJSON STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Account (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        accountID STRING,
        instanceID STRING,
        displayName STRING,
        isActive INT64,
        dateAdded TIMESTAMP,
        updatedAt TIMESTAMP,
        identityNamespace STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LegacyAccountMigration (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        instanceID STRING,
        migratedAt TIMESTAMP,
        identityNamespace STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE AccountDeletion (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        accountID STRING,
        deletedAt TIMESTAMP,
        identityNamespace STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DataContext (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        schemaVersion INT64,
        changedAt TIMESTAMP,
        contextKind STRING,
        accountID STRING,
        identityNamespace STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
